{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "port-security/mitre_techniques.schema.json",
 "title": "ATT&CK 技術（公式 STIX から生成）",
 "type": "array",
 "items": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "id",
   "name",
   "tactics",
   "version",
   "created_date",
   "last_modified",
   "detection_strategy_ids",
   "subtechniques",
   "url",
   "source_ids",
   "verified_date",
   "certainty",
   "unconfirmed_notes"
  ],
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^T\\d{4}$"
   },
   "name": {
    "type": "string",
    "minLength": 1,
    "description": "名称"
   },
   "tactics": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "description": "戦術"
   },
   "version": {
    "type": "string",
    "description": "版"
   },
   "created_date": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "description": "作成日"
   },
   "last_modified": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "description": "更新日"
   },
   "detection_strategy_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^DET\\d{4}$"
    },
    "description": "検知戦略 ID"
   },
   "subtechniques": {
    "type": "array",
    "items": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "id",
      "name",
      "detection_strategy_ids"
     ],
     "properties": {
      "id": {
       "type": "string",
       "pattern": "^T\\d{4}\\.\\d{3}$"
      },
      "name": {
       "type": "string",
       "minLength": 1
      },
      "detection_strategy_ids": {
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^DET\\d{4}$"
       }
      }
     }
    },
    "description": "サブ技術"
   },
   "url": {
    "type": "string",
    "pattern": "^https://attack\\.mitre\\.org/",
    "description": "公式ページ"
   },
   "source_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "minItems": 1,
    "uniqueItems": true,
    "description": "根拠資料 ID（sources.source_id）"
   },
   "verified_date": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "description": "最終確認日（YYYY-MM-DD）"
   },
   "certainty": {
    "enum": [
     "確認済み",
     "一部確認",
     "未確認"
    ],
    "description": "確度。確認済みには再検証済みの脅威系出典が必要"
   },
   "unconfirmed_notes": {
    "type": "string",
    "description": "未確認事項。確認済み以外では必須（空不可）"
   }
  }
 }
}
