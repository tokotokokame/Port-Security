{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "port-security/ports.schema.json",
 "title": "詳細付きポート（1 レコード = 番号 + 通信方式）",
 "type": "array",
 "items": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "id",
   "port_number",
   "transport_protocol",
   "protocol_number",
   "protocol_id",
   "service_name",
   "formal_name",
   "iana_description",
   "category",
   "purpose",
   "technical_description",
   "normal_usage_examples",
   "malicious_exploitation_cases",
   "suspicious_traffic_features",
   "investigation_checkpoints",
   "recommended_defenses",
   "attack_pattern_ids",
   "technique_ids",
   "technique_basis",
   "service_id",
   "risk_id",
   "source_ids",
   "verified_date",
   "certainty",
   "unconfirmed_notes"
  ],
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^PORT-\\d{5}-(TCP|UDP|SCTP|DCCP)$"
   },
   "port_number": {
    "type": "integer",
    "minimum": 0,
    "maximum": 65535,
    "description": "ポート番号"
   },
   "transport_protocol": {
    "enum": [
     "TCP",
     "UDP",
     "SCTP",
     "DCCP"
    ],
    "description": "通信方式"
   },
   "protocol_number": {
    "enum": [
     6,
     17,
     132,
     33
    ],
    "description": "通信方式の IP プロトコル番号（TCP=6, UDP=17, SCTP=132, DCCP=33）"
   },
   "protocol_id": {
    "type": "string",
    "pattern": "^PROTO-[A-Z0-9]+$",
    "description": "protocols.id"
   },
   "service_name": {
    "type": "string",
    "minLength": 1,
    "description": "IANA 登録名。未登録は '(未登録)'"
   },
   "formal_name": {
    "type": "string",
    "description": "正式名・慣用名"
   },
   "iana_description": {
    "type": "string",
    "description": "IANA 台帳の Description"
   },
   "category": {
    "type": "string",
    "pattern": "^[A-Z0-9]+$",
    "description": "区分（WEB, AUTH など）"
   },
   "purpose": {
    "type": "string",
    "description": "用途"
   },
   "technical_description": {
    "type": "string",
    "description": "技術説明"
   },
   "normal_usage_examples": {
    "type": "string",
    "description": "正常利用例"
   },
   "malicious_exploitation_cases": {
    "type": "string",
    "description": "悪用例"
   },
   "suspicious_traffic_features": {
    "type": "string",
    "description": "不審な通信の特徴"
   },
   "investigation_checkpoints": {
    "type": "string",
    "description": "調査観点"
   },
   "recommended_defenses": {
    "type": "string",
    "description": "対策"
   },
   "attack_pattern_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^ATK-[A-Z0-9-]+$"
    },
    "uniqueItems": true,
    "description": "攻撃手法 ID"
   },
   "technique_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^T\\d{4}(\\.\\d{3})?$"
    },
    "uniqueItems": true,
    "description": "ATT&CK 技術 ID（technique_basis に関連区分）"
   },
   "technique_basis": {
    "type": "array",
    "items": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "technique",
      "relation",
      "via"
     ],
     "properties": {
      "technique": {
       "type": "string",
       "pattern": "^T\\d{4}(\\.\\d{3})?$"
      },
      "relation": {
       "enum": [
        "direct",
        "service",
        "attack_pattern",
        "reference"
       ]
      },
      "via": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "note": {
       "type": "string"
      }
     }
    },
    "description": "技術ごとの関連区分と経路"
   },
   "service_id": {
    "anyOf": [
     {
      "type": "string",
      "pattern": "^SRV-[A-Z0-9-]+$"
     },
     {
      "type": "null"
     }
    ],
    "description": "services.id"
   },
   "risk_id": {
    "type": "string",
    "pattern": "^RISK-\\d{5}-(TCP|UDP|SCTP|DCCP)$",
    "description": "port_risks.id"
   },
   "evidence": {
    "type": "array",
    "items": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "source_id",
      "technique",
      "kind",
      "examples",
      "keyword"
     ],
     "properties": {
      "source_id": {
       "type": "string",
       "pattern": "^SRC-[A-Z0-9-]+$"
      },
      "technique": {
       "anyOf": [
        {
         "type": "string",
         "pattern": "^T\\d{4}(\\.\\d{3})?$"
        },
        {
         "type": "null"
        }
       ]
      },
      "kind": {
       "enum": [
        "技術説明",
        "手順例",
        "公式文書",
        "ATT&CK検知戦略",
        "政府勧告"
       ]
      },
      "examples": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "keyword": {
       "type": "string",
       "minLength": 1
      }
     }
    },
    "description": "ポート固有の根拠。確認済みでは必須"
   },
   "source_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "minItems": 1,
    "uniqueItems": true,
    "description": "根拠資料 ID（sources.source_id）"
   },
   "verified_date": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "description": "最終確認日（YYYY-MM-DD）"
   },
   "certainty": {
    "enum": [
     "確認済み",
     "一部確認",
     "未確認"
    ],
    "description": "確度。確認済みには再検証済みの脅威系出典が必要"
   },
   "unconfirmed_notes": {
    "type": "string",
    "description": "未確認事項。確認済み以外では必須（空不可）"
   }
  }
 }
}
