{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "port-security/protocols.schema.json",
 "title": "IP 上のプロトコル（IP プロトコル番号）",
 "type": "array",
 "items": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "id",
   "ip_protocol_number",
   "protocol_number",
   "service_name",
   "formal_name",
   "layer",
   "has_port_numbers",
   "transport_protocol",
   "purpose",
   "technical_description",
   "normal_usage_examples",
   "malicious_exploitation_cases",
   "suspicious_traffic_features",
   "investigation_checkpoints",
   "recommended_defenses",
   "attack_pattern_ids",
   "technique_ids",
   "source_ids",
   "verified_date",
   "certainty",
   "unconfirmed_notes"
  ],
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^PROTO-[A-Z0-9]+$"
   },
   "ip_protocol_number": {
    "type": "integer",
    "minimum": 0,
    "maximum": 255,
    "description": "IANA Protocol Numbers の番号"
   },
   "protocol_number": {
    "type": "integer",
    "minimum": 0,
    "maximum": 255,
    "description": "非推奨（ip_protocol_number と同値）"
   },
   "service_name": {
    "type": "string",
    "minLength": 1,
    "description": "IANA のキーワード（小文字）"
   },
   "formal_name": {
    "type": "string",
    "description": "正式名"
   },
   "layer": {
    "enum": [
     "L3",
     "L4"
    ],
    "description": "階層"
   },
   "has_port_numbers": {
    "type": "boolean",
    "description": "ポート番号を持つ通信方式か"
   },
   "transport_protocol": {
    "type": "string",
    "description": "非推奨（階層の説明文。layer を使う）"
   },
   "purpose": {
    "type": "string",
    "description": "用途"
   },
   "technical_description": {
    "type": "string",
    "description": "技術説明"
   },
   "normal_usage_examples": {
    "type": "string",
    "description": "正常利用例"
   },
   "malicious_exploitation_cases": {
    "type": "string",
    "description": "悪用例"
   },
   "suspicious_traffic_features": {
    "type": "string",
    "description": "不審な通信の特徴"
   },
   "investigation_checkpoints": {
    "type": "string",
    "description": "調査観点"
   },
   "recommended_defenses": {
    "type": "string",
    "description": "対策"
   },
   "attack_pattern_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^ATK-[A-Z0-9-]+$"
    },
    "uniqueItems": true,
    "description": "攻撃手法 ID"
   },
   "technique_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^T\\d{4}(\\.\\d{3})?$"
    },
    "uniqueItems": true,
    "description": "ATT&CK 技術 ID"
   },
   "source_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "minItems": 1,
    "uniqueItems": true,
    "description": "根拠資料 ID（sources.source_id）"
   },
   "verified_date": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "description": "最終確認日（YYYY-MM-DD）"
   },
   "certainty": {
    "enum": [
     "確認済み",
     "一部確認",
     "未確認"
    ],
    "description": "確度。確認済みには再検証済みの脅威系出典が必要"
   },
   "unconfirmed_notes": {
    "type": "string",
    "description": "未確認事項。確認済み以外では必須（空不可）"
   }
  }
 }
}
