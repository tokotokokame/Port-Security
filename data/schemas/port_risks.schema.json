{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "port-security/port_risks.schema.json",
 "title": "ポートのリスク評価",
 "type": "array",
 "items": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "id",
   "port_number",
   "transport_protocol",
   "service_name",
   "risk_level",
   "reason_targeted",
   "evaluation_factors",
   "suspicious_indicators",
   "investigation_focus",
   "mitigation_controls",
   "technique_ids",
   "source_ids",
   "verified_date",
   "certainty",
   "unconfirmed_notes"
  ],
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^RISK-\\d{5}-(TCP|UDP|SCTP|DCCP)$"
   },
   "port_number": {
    "type": "integer",
    "minimum": 0,
    "maximum": 65535,
    "description": "ポート番号"
   },
   "transport_protocol": {
    "enum": [
     "TCP",
     "UDP",
     "SCTP",
     "DCCP"
    ],
    "description": "通信方式"
   },
   "service_name": {
    "type": "string",
    "minLength": 1,
    "description": "IANA 登録名"
   },
   "risk_level": {
    "enum": [
     "Critical",
     "High",
     "Medium",
     "Low"
    ],
    "description": "リスク"
   },
   "reason_targeted": {
    "type": "string",
    "description": "狙われる理由"
   },
   "evaluation_factors": {
    "anyOf": [
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "category",
       "basis"
      ],
      "properties": {
       "category": {
        "type": "string"
       },
       "basis": {
        "type": "string"
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "external_exposure",
       "authentication",
       "encryption",
       "known_vulnerabilities"
      ],
      "properties": {
       "external_exposure": {
        "type": "string"
       },
       "authentication": {
        "type": "string"
       },
       "encryption": {
        "type": "string"
       },
       "known_vulnerabilities": {
        "type": "string"
       }
      }
     }
    ],
    "description": "評価要素（v3 形式 / v5 形式）"
   },
   "suspicious_indicators": {
    "type": "string",
    "description": "不審な兆候"
   },
   "investigation_focus": {
    "type": "string",
    "description": "調査の焦点"
   },
   "mitigation_controls": {
    "type": "string",
    "description": "対策"
   },
   "technique_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^T\\d{4}(\\.\\d{3})?$"
    },
    "uniqueItems": true,
    "description": "ATT&CK 技術 ID"
   },
   "review": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "date",
     "previous_level",
     "result",
     "evidence"
    ],
    "properties": {
     "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "previous_level": {
      "enum": [
       "Critical",
       "High",
       "Medium",
       "Low"
      ]
     },
     "result": {
      "type": "string",
      "minLength": 1
     },
     "reason": {
      "type": "string",
      "minLength": 1
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "source_id",
        "note"
       ],
       "properties": {
        "source_id": {
         "type": "string",
         "pattern": "^SRC-[A-Z0-9-]+$"
        },
        "note": {
         "type": "string",
         "minLength": 1
        }
       }
      }
     }
    },
    "description": "v1.2 の High 再検証の結果と根拠"
   },
   "source_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "minItems": 1,
    "uniqueItems": true,
    "description": "根拠資料 ID（sources.source_id）"
   },
   "verified_date": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "description": "最終確認日（YYYY-MM-DD）"
   },
   "certainty": {
    "enum": [
     "確認済み",
     "一部確認",
     "未確認"
    ],
    "description": "確度。確認済みには再検証済みの脅威系出典が必要"
   },
   "unconfirmed_notes": {
    "type": "string",
    "description": "未確認事項。確認済み以外では必須（空不可）"
   }
  }
 }
}
