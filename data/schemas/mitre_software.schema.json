{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "port-security/mitre_software.schema.json",
 "title": "ATT&CK Software（公式 STIX から生成）",
 "type": "array",
 "items": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "id",
   "name",
   "type",
   "description",
   "technique_ids",
   "url",
   "source_ids",
   "verified_date",
   "certainty",
   "unconfirmed_notes"
  ],
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^S\\d{4}$"
   },
   "name": {
    "type": "string",
    "minLength": 1,
    "description": "名称"
   },
   "type": {
    "enum": [
     "malware",
     "tool"
    ],
    "description": "種別"
   },
   "description": {
    "type": "string",
    "description": "説明"
   },
   "technique_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^T\\d{4}(\\.\\d{3})?$"
    },
    "uniqueItems": true,
    "description": "uses 関係の技術"
   },
   "url": {
    "type": "string",
    "pattern": "^https://attack\\.mitre\\.org/",
    "description": "公式ページ"
   },
   "source_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "minItems": 1,
    "uniqueItems": true,
    "description": "根拠資料 ID（sources.source_id）"
   },
   "verified_date": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "description": "最終確認日（YYYY-MM-DD）"
   },
   "certainty": {
    "enum": [
     "確認済み",
     "一部確認",
     "未確認"
    ],
    "description": "確度。確認済みには再検証済みの脅威系出典が必要"
   },
   "unconfirmed_notes": {
    "type": "string",
    "description": "未確認事項。確認済み以外では必須（空不可）"
   }
  }
 }
}
