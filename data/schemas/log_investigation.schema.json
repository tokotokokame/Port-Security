{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "port-security/log_investigation.schema.json",
 "title": "ログ調査の基盤",
 "type": "array",
 "items": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "id",
   "platform",
   "log_sources",
   "common_fields",
   "vendor_specific_fields",
   "detection_analytics",
   "investigation_procedure",
   "analytics_ids",
   "port_scope",
   "ports",
   "source_ids",
   "verified_date",
   "certainty",
   "unconfirmed_notes"
  ],
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^LOG-[A-Z0-9-]+$"
   },
   "platform": {
    "type": "string",
    "minLength": 1,
    "description": "基盤"
   },
   "log_sources": {
    "type": "array",
    "items": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "channel",
      "event_code",
      "description"
     ],
     "properties": {
      "channel": {
       "type": "string",
       "minLength": 1
      },
      "event_code": {
       "type": [
        "integer",
        "null"
       ]
      },
      "description": {
       "type": "string"
      }
     }
    },
    "minItems": 1,
    "description": "ログ源（チャネル・イベント ID）"
   },
   "common_fields": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "共通フィールド"
   },
   "vendor_specific_fields": {
    "type": "array",
    "items": {
     "type": "string"
    },
    "description": "製品固有フィールド"
   },
   "detection_analytics": {
    "type": "string",
    "description": "検知ロジック"
   },
   "investigation_procedure": {
    "type": "string",
    "minLength": 1,
    "description": "調査手順"
   },
   "analytics_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^AN\\d{4}$"
    },
    "description": "対応する ATT&CK analytic"
   },
   "port_scope": {
    "enum": [
     "analytics",
     "any",
     "platform",
     "listed"
    ],
    "description": "ポートとの対応方法（analytics=DET0118 の analytic 専用 / platform=プラットフォーム共通・ポート固有でない / any=境界機器 / listed=公式文書がポートを明示）"
   },
   "ports": {
    "type": "array",
    "items": {
     "type": "array",
     "prefixItems": [
      {
       "type": "integer",
       "minimum": 0,
       "maximum": 65535
      },
      {
       "enum": [
        "TCP",
        "UDP",
        "SCTP",
        "DCCP"
       ]
      }
     ],
     "minItems": 2,
     "maxItems": 2
    },
    "description": "port_scope=listed のときの (番号, 通信方式)"
   },
   "vendor_logs": {
    "type": "array",
    "items": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "vendor",
      "product",
      "firmware_versions",
      "log_type",
      "log_subtype",
      "log_id",
      "message",
      "fields",
      "cli_commands",
      "source_ids",
      "verification_status",
      "notes"
     ],
     "properties": {
      "vendor": {
       "type": "string",
       "minLength": 1
      },
      "product": {
       "type": "string",
       "minLength": 1
      },
      "firmware_versions": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       },
       "minItems": 1
      },
      "log_type": {
       "type": "string",
       "minLength": 1
      },
      "log_subtype": {
       "type": "string"
      },
      "log_id": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "fields": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "cli_commands": {
       "type": "array",
       "items": {
        "type": "string",
        "minLength": 1
       }
      },
      "source_ids": {
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^SRC-[A-Z0-9-]+$"
       },
       "minItems": 1,
       "uniqueItems": true
      },
      "verification_status": {
       "enum": [
        "確認済み",
        "一部確認",
        "未確認"
       ]
      },
      "notes": {
       "type": "string"
      }
     }
    },
    "description": "ベンダー機器のログ定義（版・種別・ID・フィールド・CLI ごとに出典を持つ）"
   },
   "source_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "minItems": 1,
    "uniqueItems": true,
    "description": "根拠資料 ID（sources.source_id）"
   },
   "verified_date": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "description": "最終確認日（YYYY-MM-DD）"
   },
   "certainty": {
    "enum": [
     "確認済み",
     "一部確認",
     "未確認"
    ],
    "description": "確度。確認済みには再検証済みの脅威系出典が必要"
   },
   "unconfirmed_notes": {
    "type": "string",
    "description": "未確認事項。確認済み以外では必須（空不可）"
   }
  }
 }
}
