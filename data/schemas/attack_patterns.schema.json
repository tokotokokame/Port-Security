{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "port-security/attack_patterns.schema.json",
 "title": "攻撃手法",
 "type": "array",
 "items": {
  "type": "object",
  "additionalProperties": false,
  "required": [
   "id",
   "attack_name",
   "category",
   "description",
   "attack_features",
   "detection_methods",
   "recommended_defenses",
   "technique_ids",
   "log_investigation_ids",
   "source_ids",
   "verified_date",
   "certainty",
   "unconfirmed_notes"
  ],
  "properties": {
   "id": {
    "type": "string",
    "pattern": "^ATK-[A-Z0-9-]+$"
   },
   "attack_name": {
    "type": "string",
    "minLength": 1,
    "description": "名称"
   },
   "category": {
    "type": "string",
    "description": "区分"
   },
   "description": {
    "type": "string",
    "description": "概要"
   },
   "attack_features": {
    "type": "string",
    "description": "特徴"
   },
   "detection_methods": {
    "type": "string",
    "minLength": 1,
    "description": "検知方法"
   },
   "recommended_defenses": {
    "type": "string",
    "description": "対策"
   },
   "technique_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^T\\d{4}(\\.\\d{3})?$"
    },
    "uniqueItems": true,
    "description": "ATT&CK 技術 ID"
   },
   "log_investigation_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^LOG-[A-Z0-9-]+$"
    },
    "uniqueItems": true,
    "description": "ログ調査 ID"
   },
   "port_relation": {
    "enum": [
     "generic",
     "service_specific"
    ],
    "description": "ポートとの関係（generic=どの公開サービスにも当てはまる）"
   },
   "attack_mapping_status": {
    "enum": [
     "確認済み",
     "一部確認",
     "未確認"
    ],
    "description": "ATT&CK 技術への対応付けの確認状態（公式 STIX との照合）"
   },
   "content_verification_status": {
    "enum": [
     "確認済み",
     "一部確認",
     "未確認"
    ],
    "description": "説明・特徴・検知・対策の本文の確認状態"
   },
   "content_source_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "uniqueItems": true,
    "description": "本文の根拠資料 ID"
   },
   "source_ids": {
    "type": "array",
    "items": {
     "type": "string",
     "pattern": "^SRC-[A-Z0-9-]+$"
    },
    "minItems": 1,
    "uniqueItems": true,
    "description": "根拠資料 ID（sources.source_id）"
   },
   "verified_date": {
    "type": "string",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "description": "最終確認日（YYYY-MM-DD）"
   },
   "certainty": {
    "enum": [
     "確認済み",
     "一部確認",
     "未確認"
    ],
    "description": "確度。確認済みには再検証済みの脅威系出典が必要"
   },
   "unconfirmed_notes": {
    "type": "string",
    "description": "未確認事項。確認済み以外では必須（空不可）"
   }
  }
 }
}
