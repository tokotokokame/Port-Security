  {
    "id": "LOG-FORTIGATE-VENDOR",
    "platform": "FortiGate（FortiOS 7.4 / 7.6。版ごとに vendor_logs で区別）",
    "log_sources": [
      {
        "channel": "Traffic ログ（type=traffic / subtype=forward）",
        "event_code": 13,
        "description": "LOG_ID_TRAFFIC_END_FORWARD（転送通信のセッション）"
      },
      {
        "channel": "Event ログ（type=event / subtype=system）",
