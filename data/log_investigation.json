[
  {
    "id": "LOG-WIN-AN0327",
    "platform": "Windows (Server / Workstation)",
    "log_sources": [
      {
        "channel": "WinEventLog:System",
        "event_code": 1000,
        "description": "アプリケーションエラー (サービス/プロセス異常終了・クラッシュ)"
      },
      {
        "channel": "WinEventLog:Sysmon",
        "event_code": 1,
        "description": "プロセス生成 (不審な親プロセス・子プロセス実行)"
      },
      {
        "channel": "WinEventLog:Sysmon",
        "event_code": 3,
        "description": "ネットワーク接続確立 (送信元/宛先IP・ポート)"
      },
      {
        "channel": "WinEventLog:Sysmon",
        "event_code": 7,
        "description": "モジュールロード (不審なDLLロード)"
      },
      {
        "channel": "WinEventLog:Sysmon",
        "event_code": 10,
        "description": "プロセスアクセス (メモリ割り当て・注入)"
      },
      {
        "channel": "WinEventLog:Sysmon",
        "event_code": 11,
        "description": "ファイル生成 (ドロップされたマルウェア/スクリプト)"
      },
      {
        "channel": "WinEventLog:Sysmon",
        "event_code": 22,
        "description": "DNSクエリ発信"
      },
      {
        "channel": "WinEventLog:Security",
        "event_code": 4624,
        "description": "アカウントログオン成功 (LogonType 3: Network, 10: RemoteInteractive)"
      },
      {
        "channel": "WinEventLog:Security",
        "event_code": 4625,
        "description": "アカウントログオン失敗"
      }
    ],
    "common_fields": [
      "Timestamp",
      "Source IP (SrcIP)",
      "Source Port (SrcPort)",
      "Destination IP (DestIP)",
      "Destination Port (DestPort)",
      "Protocol",
