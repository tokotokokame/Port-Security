    ],
    "vendor_specific_fields": [
      "EventID",
      "Image",
      "ParentImage",
      "CommandLine",
      "User",
      "ProcessGuid",
      "LogonType",
      "TargetUserName"
    ],
    "detection_analytics": "AN0327: 監視ポート(445, 135, 3389, 5985, 5986)へのインバウンド接続と、相関ウィンドウ内(既定10分)でのサービスクラッシュ(EventCode 1000)および不審子プロセス(EventCode 1)を相関検知。",
    "investigation_procedure": "1. NSM Flowで高エラー率のインバウンド接続を特定\n2. 対象ホストのSystemログでEvent 1000を検索\n3. 同時刻帯のSysmon Event 1で親プロセスがサービス(spoolsv, svchost, wsmprovhost)である不審子プロセス(cmd, powershell)を特定",
    "unconfirmed_notes": "AN0327公式のログ源はSystem 1000/Sysmon 1,3,7,10,11,22。Security 4624/4625は本DB独自の追記。",
    "source_ids": [
      "SRC-MS-RDS",
      "SRC-MITRE-DET0118"
    ],
    "verified_date": "2026-11-21",
    "certainty": "一部確認",
    "analytics_ids": [
      "AN0327"
    ],
    "port_scope": "analytics",
    "ports": []
  },
  {
    "id": "LOG-LIN-AN0328",
    "platform": "Linux (RHEL / Ubuntu / Debian)",
    "log_sources": [
      {
        "channel": "linux:syslog / journalctl",
        "event_code": null,
        "description": "kernel/systemdメッセージ ('segmentation fault', 'core dumped', 'service terminated unexpectedly')"
      },
      {
        "channel": "auditd:SYSCALL",
        "event_code": null,
        "description": "execveシステムコール (サービスアカウントからの/bin/sh, /bin/bash, /usr/bin/curl起動)"
      },
      {
        "channel": "linux:auth.log / secure",
        "event_code": null,
        "description": "SSH認証成功・失敗ログ ('Failed password', 'Accepted publickey')"
      }
    ],
    "common_fields": [
      "Timestamp",
      "Source IP",
      "Source Port",
      "Destination IP",
      "Destination Port",
      "Protocol",
      "Action"
    ],
    "vendor_specific_fields": [
      "syslog_message",
      "exe",
      "auid",
      "uid",
      "gid",
      "pid",
      "ppid",
      "comm",
      "terminal"
    ],
    "detection_analytics": "AN0328: sshd, smbd, nfsd, httpd, mysqld等のデーモンのクラッシュ/コアダンプと、サービスコンテキストからのシェル実行を相関検知。",
    "investigation_procedure": "1. /var/log/syslog または journalctl で 'segmentation fault' を検索\n2. ausearch -m SYSCALL -ts recent で execve ログを抽出\n3. サービスアカウント(apache, mysql, nobody)が起動したコマンドラインを検証",
    "unconfirmed_notes": "AN0328公式のログ源はsyslog/auditd/NSM Flow。auth.log/secureは本DB独自の追記。",
    "source_ids": [
      "SRC-MITRE-DET0118"
    ],
    "verified_date": "2026-11-21",
    "certainty": "一部確認",
    "analytics_ids": [
      "AN0328"
    ],
    "port_scope": "analytics",
    "ports": []
  },
