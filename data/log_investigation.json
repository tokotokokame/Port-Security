        "description": "LOG_ID_ADMIN_LOGIN_FAIL（管理者ログイン失敗）"
      },
      {
        "channel": "Event ログ（type=event / subtype=vpn）",
        "event_code": 39426,
        "description": "SSL VPN ログイン失敗（7.4。7.6.3 以降はトンネルモード廃止）"
      },
      {
        "channel": "Event ログ（type=event / subtype=vpn）",
        "event_code": 37138,
        "description": "MESGID_CONN_UPDOWN（IPsec 接続状態の変化）"
      }
    ],
    "common_fields": [
      "srcip",
      "srcport",
      "dstip",
      "dstport",
      "proto",
